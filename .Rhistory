)
install.packages("tidyr")
library(tidyr)
df <- df %>%
mutate(
poids_kg = ifelse(is.na(poids_kg), median(poids_kg, na.rm = TRUE), poids_kg),
across(where(is.character), ~replace_na(.x, "Unknown")) # Apply only to character columns
)
df <- df %>%
mutate(
sexe = as.factor(sexe),
lieu = as.factor(lieu),
procedure = as.factor(procedure),
destination = as.factor(destination)
)
df <- df %>%
select(-row_id, everything())  # Ensure row_id exists before removing
glimpse(df)
